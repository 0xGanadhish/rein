{
  "name": "rein",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "lint": "eslint worker shared scripts web --max-warnings=0",
    "format": "prettier --write worker shared scripts web near evm package.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check worker shared scripts web near evm package.json eslint.config.mjs .prettierrc.json",
    "fmt:rust": "cargo fmt --manifest-path near/Cargo.toml --all",
    "fmt:rust:check": "cargo fmt --manifest-path near/Cargo.toml --all --check",
    "fmt:sol": "forge fmt --root evm",
    "fmt:sol:check": "forge fmt --root evm --check",
    "demo": "node --experimental-strip-types --env-file-if-exists=.env scripts/demo.ts",
    "demo:replay": "node --experimental-strip-types --env-file-if-exists=.env scripts/demo-replay.ts",
    "verify:signer": "node --experimental-strip-types --env-file-if-exists=.env scripts/verify-signer.ts",
    "deploy:desk": "node --experimental-strip-types --env-file-if-exists=.env scripts/deploy-desk.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "viem": "2.57.16",
    "vitest": "5.1.0"
  }
}
